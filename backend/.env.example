# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=dev-secret-key-change-in-production-798234789
JWT_SECRET_KEY=jwt-super-secret-key-9812739182
JWT_EXPIRATION_HOURS=72

# Database: SQLite for zero-setup local dev, or PostgreSQL connection string
# Example Postgres: postgresql://postgres:password@localhost:5432/minilms
DATABASE_URL=sqlite:///minilms.db

# Video Security & Playback Token
VIDEO_TOKEN_SECRET=video-stream-hmac-secret-token-389172
VIDEO_TOKEN_EXPIRY_SECONDS=300

# Razorpay Test Configuration (Replace with your Razorpay Test Key and Secret)
# For local testing without active keys, the system includes an automatic test sandbox simulator
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_demo

# Regional & Display Settings
TIMEZONE=Asia/Kolkata
CURRENCY=INR
CURRENCY_SYMBOL=₹

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
